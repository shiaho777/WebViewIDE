{
  "name": "webviewide-editor",
  "private": true,
  "version": "1.0.0",
  "description": "CodeMirror 6 bundle for the WebViewIDE editor face. Build output is committed to app/src/main/assets/editor/ so the Android build needs no Node.",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@emmetio/codemirror6-plugin": "^0.4.2",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
